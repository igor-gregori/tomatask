{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tomatask",
  "compatibility_date": "2026-10-01",
  // Site 100% estático: a Cloudflare serve a pasta dist sem nenhum código de servidor.
  // Domínio próprio: a Cloudflare cria o DNS e o certificado HTTPS automaticamente.
  "routes": [{ "pattern": "tomatask.igreg.dev", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
